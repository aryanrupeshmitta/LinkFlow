# Server Port
PORT=3000

# Base URL for generated short links
BASE_URL=http://localhost:3000

# Storage Engine Options: auto | mongodb | local
STORAGE_ENGINE=auto

# MongoDB Connection (Used when STORAGE_ENGINE=mongodb or auto)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=urlShortenerDB

# API Security
API_KEY=admin-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
